# ---- 公開可 ----
NEXT_PUBLIC_SITE_URL=https://ha-ma.dev
NEXT_PUBLIC_SUPABASE_URL=              # ローカル: http://127.0.0.1:54321 / 本番: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=         # supabase start の "anon key" / 本番: Project Settings > API
NEXT_PUBLIC_TURNSTILE_SITE_KEY=        # Cloudflare Turnstile サイトキー（ローカルの常に成功するテストキー: 1x00000000000000000000AA）

# ---- 秘密（Vercel の Environment Variables に登録。リポジトリには入れない） ----
SUPABASE_SERVICE_ROLE_KEY=             # supabase start の "service_role key" / 本番: Project Settings > API
ADMIN_EMAIL=me@ha-ma.dev               # 管理画面にログインできる唯一のメールアドレス
TURNSTILE_SECRET_KEY=                  # Turnstile シークレット（ローカル: 1x0000000000000000000000000000000AA）
RESEND_API_KEY=                        # Resend の API キー（未設定なら通知メールはスキップ）
MAIL_FROM=noreply@ha-ma.dev            # Resend で認証済みドメインのアドレス
MAIL_TO=inquiry@ha-ma.dev,01yhamaya05@gmail.com   # 通知先。カンマ区切りで複数可（先頭が自動返信の Reply-To になる）
AUTO_REPLY=on                          # 送信者への自動返信（off で無効）
FORM_HMAC_SECRET=                      # openssl rand -hex 32
REVALIDATE_SECRET=                     # openssl rand -hex 32（/api/revalidate 用）

# ---- 任意 ----
RATE_LIMIT_PER_10MIN=3
RATE_LIMIT_PER_DAY=10
